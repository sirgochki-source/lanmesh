*.cf_token
*.token
.dev.vars
*.pem
*.key

# собранные бинарники (пересобираются из исходников)
# Шаблоны привязаны к корню репозитория и к именам конкретных команд: прежние
# «*-arm64» и «*-linux-*» ловили что угодно с этими кусками в имени в ЛЮБОЙ
# папке — на этом молча потерялись docs/.../2026-09-01-linux-port-design.md
# и план к нему.
*.exe
*~
*.zip
/lanmesh-linux-*
/natcheck-linux-*
/lanmesh-relay-*
/lanmesh-signal-*

# кэш Wrangler (содержит ID аккаунта Cloudflare)
worker/.wrangler/
.wrangler/

# сторонняя библиотека — пользователь кладёт свою (у Wintun отдельная лицензия)
wintun.dll

# идентичность узла (у каждого своя) и локальные данные
identity
config.json
node2/
*.log

